FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install FUSE3 and build essentials for fusepy
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fuse \
        libfuse-dev \
        fuse3 \
        libfuse3-dev \
        pkg-config \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

# Copy the entire repository (keeps infra + data helpers for reference)
COPY . .

RUN mkdir -p /mnt/llmfuse && echo "user_allow_other" >> /etc/fuse.conf

VOLUME ["/mnt/llmfuse"]

ENTRYPOINT ["python", "-m", "llmfuse.llmfuse", "/mnt/llmfuse"]
