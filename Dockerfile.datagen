FROM python:3.12-slim

# Install system dependencies for filesystem operations and FUSE
RUN apt-get update && \
    apt-get install -y \
    coreutils \
    findutils \
    util-linux \
    procps \
    fuse3 \
    libfuse3-dev \
    libfuse2 \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Create app directory and data directories
WORKDIR /app
RUN mkdir -p /app/data/train /app/data/eval && chmod -R 755 /app/data

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all the source packages
COPY common/ ./common/
COPY llmfuse/ ./llmfuse/
COPY llmencode/ ./llmencode/
COPY train/ ./train/
COPY eval/ ./eval/

# Create a non-root user for safer operations
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app

# Create fuse group and add appuser to it for FUSE access
RUN groupadd -f fuse && usermod -a -G fuse appuser

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Default command uses the updated train module
CMD ["python", "-m", "train.generate_data", "--num_examples", "100", "--output_dir", "/app/data/train"] 